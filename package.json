{
  "scripts": {
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "test:all": "npm test && npm run test:integration",
    "test:coverage": "jest -c jest.coverage.config.js --coverage",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "knex --knexfile src/lib/knex/knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile src/lib/knex/knexfile.ts migrate:rollback",
    "migrate:status": "knex --knexfile src/lib/knex/knexfile.ts migrate:status",
    "migrate:make": "knex --knexfile src/lib/knex/knexfile.ts migrate:make"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/helmet": "^0.0.48",
    "@types/ioredis": "^4.28.10",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "dotenv": "^18.0.1",
    "eslint": "^10.11.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "node-mailjet": "^6.0.11",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^11.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
